# Server Port
PORT=5000

# Database Configuration (Optional, falls back to JSON file database if empty/failed)
MONGO_URI=mongodb://localhost:27017/kdn-sports

# JWT Secret
JWT_SECRET=super_secret_kdn_jwt_token_key_12345

# Secret Admin Email (For Site Shutdown Control)
SECRET_ADMIN_EMAIL=workzeez2026@gmail.com

# SMTP Configuration (Optional, falls back to console logger if empty/failed)
# For real Gmail: use smtp.gmail.com, your Gmail address, and an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudinary Integration (Optional, fallback to local DB Base64 storing if empty)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
